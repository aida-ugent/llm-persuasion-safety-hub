const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path}`;
---

<PageLayout meta={meta}>
	<h1 class="title mb-8">Resources</h1>
	<div class="border-accent/60 bg-accent/10 mb-6 rounded-md border px-4 py-3">
		<p class="text-accent text-sm font-semibold">
			⚠️ This resource list is still being updated and expanded.
		</p>
	</div>

	<div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
		<input
			id="resource-search"
			type="search"
			placeholder="Search studies…"
			class="border-accent/40 focus:border-accent mr-2 rounded border bg-transparent px-3 py-1.5 text-sm placeholder:opacity-40 focus:outline-none"
		/>
		<span class="opacity-50">Filter:</span>
		<button
			class="filter-btn border-accent/40 text-accent/70 rounded border px-3 py-1 transition-colors"
			data-filter="personalisation">Personalisation</button
		>
		<button
			class="filter-btn border-accent/40 text-accent/70 rounded border px-3 py-1 transition-colors"
			data-filter="strategy">Strategy</button
		>
		<button
			class="filter-btn border-accent/40 text-accent/70 rounded border px-3 py-1 transition-colors"
			data-filter="hasData">Has data</button
		>
		<button
			class="filter-btn border-accent/40 text-accent/70 rounded border px-3 py-1 transition-colors"
			data-filter="hasCode">Has code</button
		>
	</div>

	<div class="overflow-x-auto">
		<table id="resource-table" class="w-full border-collapse text-sm">
			<thead>
				<tr class="border-accent/30 border-b-2">
					<th class="pr-6 pb-3 text-left font-semibold">Study</th>
					<th
						class="cursor-help pr-4 pb-3 text-center font-semibold whitespace-nowrap"
						data-tooltip="Includes personalisation analysis"
					>
						Personalisation
					</th>
					<th
						class="cursor-help pr-4 pb-3 text-center font-semibold whitespace-nowrap"
						data-tooltip="Includes persuasion strategy/tactic analysis"
					>
						Strategy
					</th>
					<th class="pr-6 pb-3 text-left font-semibold whitespace-nowrap">Data</th>
					<th class="pb-3 text-center font-semibold whitespace-nowrap">Code</th>
				</tr>
			</thead>
			<tbody class="divide-accent/10 divide-y">
				{
					resources.map((resource) => (
						<tr
							class="hover:bg-accent/5 transition-colors"
							data-personalisation={resource.personalisation ? "1" : "0"}
							data-strategy={resource.strategy ? "1" : "0"}
							data-has-data={
								getResourceLinks(resource.dataset).some((dl) => !!getResourceHref(dl)) ? "1" : "0"
							}
							data-has-code={resource.code ? "1" : "0"}
							data-search={`${resource.title} ${getShortAuthors(resource.authors)}`.toLowerCase()}
						>
							<td class="min-w-[220px] py-3 pr-6 align-top">
								{resource.paper ? (
									<a
										href={getResourceUrl(resource.paper)}
										target="_blank"
										rel="noreferrer"
										class="leading-snug font-medium hover:underline"
									>
										{resource.title}
									</a>
								) : (
									<p class="leading-snug font-medium">{resource.title}</p>
								)}
								<p class="mt-0.5 text-xs opacity-50">
									{resource.year}
									{resource.year && resource.authors.length > 0 && " · "}
									{getShortAuthors(resource.authors)}
								</p>
							</td>
							<td class="py-3 pr-4 text-center align-top">
								{resource.personalisation ? (
									<span class="text-accent font-bold">✓</span>
								) : (
									<span class="opacity-20">—</span>
								)}
							</td>
							<td class="py-3 pr-4 text-center align-top">
								{resource.strategy ? (
									<span class="text-accent font-bold">✓</span>
								) : (
									<span class="opacity-20">—</span>
								)}
							</td>
							<td class="py-3 pr-6 align-top">
								<div class="flex flex-col gap-1">
									{getResourceLinks(resource.dataset).map((dl) => {
										const href = getResourceHref(dl);
										const name = getDatasetName(dl);
										return href ? (
											<a
												href={href}
												target="_blank"
												rel="noreferrer"
												class="text-accent text-xs whitespace-nowrap hover:underline"
											>
												{name}
											</a>
										) : (
											<span class="text-xs whitespace-nowrap opacity-40">{name}</span>
										);
									})}
								</div>
							</td>
							<td class="py-3 text-center align-top">
								<div class="flex flex-col items-center gap-1">
									{resource.studyWebsite && (
										<a
											href={getResourceUrl(resource.studyWebsite)}
											target="_blank"
											rel="noreferrer"
											class="text-accent hover:opacity-70"
											title="Study website"
										>
											🔗
										</a>
									)}
									{resource.code && (
										<a
											href={getResourceUrl(resource.code)}
											target="_blank"
											rel="noreferrer"
											class="text-accent hover:opacity-70"
										>
											💻
										</a>
									)}
								</div>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<section class="prose prose-sm prose-cactus mt-12 max-w-none">
		<h3>How to contribute</h3>
		<p>
			If you know of a relevant resource that is missing, there are two ways to add it:
			<ul class="list-inside list-disc">
				<li>
					<strong>Contact us</strong> — email us the resource information, details in the <a
						href={withBase("/contact/")}>Contact</a
					> page.
				</li>
				<li>
					<strong>GitHub</strong> — add it to the website's <a
						href="https://github.com/aida-ugent/llm-persuasion-safety-hub"
						target="_blank"
						rel="noreferrer">GitHub repository</a
					> and raise a pull request.
				</li>
			</ul>
		</p>
	</section>

	<style>
		.filter-btn.is-active {
			background-color: var(--color-accent);
			border-color: var(--color-accent);
			color: var(--color-global-bg);
		}
	</style>

	<script>
		// --- filters ---
		const search = document.getElementById("resource-search") as HTMLInputElement;
		const btns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
		const rows = document.querySelectorAll<HTMLTableRowElement>("#resource-table tbody tr");
		const active = new Set<string>();

		function applyFilters() {
			const q = search.value.toLowerCase().trim();
			rows.forEach((row) => {
				const d = row.dataset;
				const show =
					(!q || (d.search ?? "").includes(q)) &&
					(!active.has("personalisation") || d.personalisation === "1") &&
					(!active.has("strategy") || d.strategy === "1") &&
					(!active.has("hasData") || d.hasData === "1") &&
					(!active.has("hasCode") || d.hasCode === "1");
				row.style.display = show ? "" : "none";
			});
		}

		btns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const key = btn.dataset.filter!;
				if (active.has(key)) {
					active.delete(key);
					btn.classList.remove("is-active");
				} else {
					active.add(key);
					btn.classList.add("is-active");
				}
				applyFilters();
			});
		});

		search.addEventListener("input", applyFilters);

		// --- column header tooltips ---
		const tip = document.createElement("div");
		tip.style.cssText =
			"position:fixed;z-index:50;max-width:14rem;padding:0.375rem 0.5rem;border-radius:0.25rem;font-size:0.75rem;line-height:1.4;pointer-events:none;display:none;background-color:var(--color-global-text);color:var(--color-global-bg);box-shadow:0 4px 6px -1px rgb(0 0 0/0.2)";
		document.body.appendChild(tip);

		document.querySelectorAll<HTMLElement>("th[data-tooltip]").forEach((th) => {
			th.addEventListener("mouseenter", () => {
				tip.textContent = th.dataset.tooltip!;
				tip.style.display = "block";
			});
			th.addEventListener("mousemove", (e) => {
				tip.style.top = e.clientY + 16 + "px";
				tip.style.left = e.clientX + "px";
				tip.style.transform = "translateX(-50%)";
			});
			th.addEventListener("mouseleave", () => {
				tip.style.display = "none";
			});
		});
	</script>
</PageLayout>
