---
import PageLayout from "@/layouts/Base.astro";

const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path}`;
---

<PageLayout meta={{ title: "Home" }}>
	<!-- <section>
		<SocialList />
	</section> -->

	<h1 class="title mb-8">Welcome</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			<strong>LLM Persuasion Safety Hub</strong> is a curated collection of datasets, benchmarks, and
			automated evaluation tools for studying persuasive capabilities in large language models (LLMs).
			The goal is to bring together the most relevant resources as they emerge, helping researchers navigate
			this rapidly evolving field.
		</p>
		<h3>What is included</h3>
		<p>
			The hub covers research papers, datasets, and codebases relevant to LLM persuasiveness
			evaluation.
		</p>
		<hr />
		<h3>Companion paper</h3>
		<p>
			This resource hub is a companion to a review paper on automated methods for evaluating LLM
			persuasiveness.
		</p>
		<div class="not-prose my-5 flex gap-4 rounded-md border border-current/[0.15] px-4 py-3">
			<a target="_blank" href="https://zenodo.org/records/20703534" class="shrink-0">
				<img
					src={withBase("/paper_front.png")}
					alt="Paper preview"
					class="w-20 rounded opacity-80 shadow-sm transition-opacity hover:opacity-100"
				/>
			</a>
			<div>
				<p class="text-sm leading-snug font-medium">
					<a
						target="_blank"
						href="https://zenodo.org/records/20703534"
						class="underline underline-offset-2"
					>
						<em>LLM Persuasiveness Evaluation: A Structured Review of Automated Methods</em>
					</a>
				</p>
				<p class="mt-1 text-xs opacity-50">Dementaviciute, K. · Bied, G. C. M. · De Bie, T.</p>
				<ul class="mt-2 list-inside list-disc space-y-0.5 text-xs opacity-70">
					<li>
						Accepted to the <a
							target="_blank"
							href="https://aimii.info/"
							class="underline underline-offset-2">AIMII Workshop</a
						>
						at <a
							target="_blank"
							href="https://www.iaseai.org/our-programs/iaseai26"
							class="underline underline-offset-2">IASEAI</a
						>, February 2026, Paris, France (poster, non-archival)
					</li>
					<li>
						Accepted to the <a
							target="_blank"
							href="https://trustworthy-ai-for-good.github.io/"
							class="underline underline-offset-2">AI4GOOD Workshop</a
						> at <a target="_blank" href="https://icml.cc/" class="underline underline-offset-2"
							>ICML</a
						>, July 2026, Seoul, South Korea (poster, non-archival)
					</li>
					<li>Currently under review as a journal publication</li>
				</ul>
			</div>
		</div>

		<h3>Taxonomy</h3>
		<p>
			The following taxonomy organises the evaluation approaches covered in our review, with each
			method's category shown in the resources table.
			<br /><small class="opacity-60"
				><strong>Note:</strong> the table only includes entries for covered papers with an associated
				resource, alongside papers that provide a relevant resource, but were not covered in the review.</small
			>
		</p>
		<div class="not-prose my-6 overflow-x-auto">
			<div id="tax-root" class="relative pb-2" style="min-width:500px">
				<div class="tf-tree">
					<div class="tf-node">
						<div class="tf-label tf-root-label">Automated Textual<br />Persuasion Evaluation</div>
						<div class="tf-ch">
							<div class="tf-node tf-hl">
								<div class="tf-label">
									LLM<br />Persuasiveness
								</div>
								<div class="tf-ch">
									<div class="tf-node tf-hl">
										<div class="tf-label">
											Simulation-based<br />Methods
										</div>
										<div class="tf-ch">
											<div class="tf-node tf-hl">
												<div class="tf-label">
													Dialogue<br />Simulations
												</div>
												<div class="tf-ch">
													<div class="tf-node tf-hl">
														<div class="tf-label">Multi-turn</div>
													</div>
													<div class="tf-node tf-hl">
														<div class="tf-label">Single-turn</div>
													</div>
													<div class="tf-node tf-hl">
														<div class="tf-label">Mixed</div>
													</div>
												</div>
											</div>

											<div class="tf-node tf-hl">
												<div class="tf-label">
													Game<br />Simulations
												</div>
											</div>
										</div>
									</div>

									<div class="tf-node tf-hl">
										<div class="tf-label">
											Dataset-based<br />Methods
										</div>
										<div class="tf-ch">
											<div class="tf-node tf-hl">
												<div class="tf-label">
													Prompt-based<br />Methods
												</div>
											</div>
											<div class="tf-node tf-hl">
												<div class="tf-label">
													Supervised<br />Scoring Models
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<div class="tf-node">
								<div class="tf-label">Text<br />Persuasiveness</div>
							</div>
						</div>
					</div>
				</div>
				<svg
					id="tax-svg"
					aria-hidden="true"
					style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;"
				></svg>
			</div>
		</div>

		<h3>Cite this work</h3>
		<p>If you use this website for research, please cite our preprint:</p>
		<pre><code>@misc&#123;dementaviciute_2026,
  author       = &#123;Dementaviciute, Kamile and Bied, Guillaume and De Bie, Tijl&#125;,
  title        = &#123;LLM Persuasiveness Evaluation: A Structured Review of Automated Methods&#125;,
  month        = jun,
  year         = 2026,
  publisher    = &#123;Zenodo&#125;,
  doi          = &#123;10.5281/zenodo.20703534&#125;,
  url          = &#123;https://doi.org/10.5281/zenodo.20703534&#125;,
&#125;</code></pre>

		<hr />
		<h3>How to contribute</h3>
		<p>
			If you know of a relevant resource that is missing, there are two ways to add it:
			<ul class="list-inside list-disc">
				<li>
					<strong>Contact us</strong> — email us the resource information, details in the <a
						href={withBase("/contact/")}>Contact</a
					> page.
				</li>
				<li>
					<strong>GitHub</strong> — add it to the website's <a
						href="https://github.com/aida-ugent/llm-persuasion-safety-hub"
						target="_blank"
						rel="noreferrer">GitHub repository</a
					> and raise a pull request.
				</li>
			</ul>
		</p>
	</div>
	<style>
		.tf-tree {
			display: flex;
			justify-content: center;
			font-size: 0.65rem;
			padding: 0.25rem 0;
		}
		.tf-node {
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.tf-ch {
			display: flex;
			flex-direction: row;
			align-items: flex-start;
			gap: 5px;
			padding-top: 22px;
		}
		.tf-label {
			border: 1px solid currentColor;
			border-radius: 4px;
			padding: 3px 6px;
			text-align: center;
			line-height: 1.4;
			opacity: 0.45;
		}
		hr {
			border: none;
			border-top: 1px solid currentColor;
			opacity: 0.12;
			margin: 1.5rem 0;
		}
		.tf-root-label {
			font-weight: 600;
			opacity: 0.8;
		}
		.tf-hl > .tf-label {
			border-color: rgb(59 130 246 / 0.55);
			background-color: rgb(59 130 246 / 0.08);
			color: rgb(59 130 246);
			opacity: 1;
		}
	</style>

	<script>
		function drawTaxLines() {
			const root = document.getElementById("tax-root");
			const svg = document.getElementById("tax-svg") as SVGSVGElement | null;
			if (!root || !svg) return;

			svg.innerHTML = "";
			const wRect = root.getBoundingClientRect();

			function mkLine(x1: number, y1: number, x2: number, y2: number, blue: boolean) {
				const el = document.createElementNS("http://www.w3.org/2000/svg", "line");
				el.setAttribute("x1", String(x1));
				el.setAttribute("y1", String(y1));
				el.setAttribute("x2", String(x2));
				el.setAttribute("y2", String(y2));
				el.setAttribute("stroke", blue ? "rgb(59 130 246)" : "currentColor");
				el.setAttribute("stroke-opacity", blue ? "0.45" : "0.3");
				el.setAttribute("stroke-width", "1.5");
				svg!.appendChild(el);
			}

			root.querySelectorAll<HTMLElement>(".tf-node").forEach((node) => {
				const label = node.querySelector<HTMLElement>(":scope > .tf-label");
				const ch = node.querySelector<HTMLElement>(":scope > .tf-ch");
				if (!label || !ch) return;

				const lr = label.getBoundingClientRect();
				const px = lr.left + lr.width / 2 - wRect.left;
				const py = lr.bottom - wRect.top;

				const children = Array.from(ch.querySelectorAll<HTMLElement>(":scope > .tf-node"));
				if (!children.length) return;

				const isHl = node.classList.contains("tf-hl");
				const cInfo = children.map((cn) => {
					const cl = cn.querySelector<HTMLElement>(":scope > .tf-label")!;
					const cr = cl.getBoundingClientRect();
					return { x: cr.left + cr.width / 2 - wRect.left, y: cr.top - wRect.top };
				});

				const midY = (py + cInfo[0]!.y) / 2;
				mkLine(px, py, px, midY, isHl);
				mkLine(cInfo[0]!.x, midY, cInfo[cInfo.length - 1]!.x, midY, isHl);
				cInfo.forEach((c) => mkLine(c.x, midY, c.x, c.y, isHl));
			});
		}

		document.addEventListener("DOMContentLoaded", drawTaxLines);
		window.addEventListener("resize", drawTaxLines);
	</script>
</PageLayout>
